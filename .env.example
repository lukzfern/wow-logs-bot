# 1. Create a Discord Application at https://discord.com/developers/applications
# 2. Go to Bot → copy the token
# 3. Go to OAuth2 → copy the Client ID
# 4. Invite the bot: https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=326417591296&scope=bot+applications.commands
#    (permissions: Send Messages, Create Public Threads, Send Messages in Threads, Embed Links, Read Message History)
# 5. Get your WoW Logs API key at https://wow-logs.co.in/account/api
# 6. Copy this file to .env and fill in the values
# 7. npm install && npm run build && npm start
# 8. In Discord, run: /setup realm:wow-patagonia guild:Serenity channel:#raid-logs

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
WOWLOGS_API_KEY=wl_live_your_key_here

# Poll interval in ms (default 2 min — fits well within 300 RPM pro limit)
POLL_INTERVAL_MS=120000
